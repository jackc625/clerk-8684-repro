# Publishable key from a Clerk *development* instance.
#
# Configure that instance under:
#   Dashboard → User & Authentication → Email, Phone, Username → Email address
#     ✅ Email verification code
#     ❌ Email verification link
#
# A pk_test_ key is publishable by design (it ships in the client bundle),
# so it is not a secret — but do NOT commit a real .env; commit only this example.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
